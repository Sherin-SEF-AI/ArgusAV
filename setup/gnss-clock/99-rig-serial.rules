# Stable names for the rig's serial sensors, independent of USB enumeration order.
SUBSYSTEM=="tty", ATTRS{idVendor}=="1546", ATTRS{idProduct}=="01a9", SYMLINK+="gnss0", GROUP="dialout", MODE="0660"
SUBSYSTEM=="tty", ATTRS{idVendor}=="2639", ATTRS{idProduct}=="0300", SYMLINK+="imu0", GROUP="dialout", MODE="0660"
# Xsens via FTDI: 1 ms latency timer keeps IMU arrival-time jitter sub-millisecond.
ACTION=="add", SUBSYSTEM=="usb-serial", DRIVER=="ftdi_sio", ATTR{latency_timer}="1"
